# Controls how BigWigs packager builds the zip file.
# Hidden files and folders (like .github and .release) are always left out.
package-as: TidyPack

# The changelog uploaded with every file.
manual-changelog:
  filename: CHANGELOG.md
  markup-type: markdown

# Development files that must not go to the players.
ignore:
  - AGENTS.md
  - CLAUDE.md
