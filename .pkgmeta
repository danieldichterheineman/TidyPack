# Styr hur BigWigs packager bygger zip-filen.
# Dolda filer och mappar (som .github och .release) utesluts alltid.
package-as: TidyPack

# Ändringsloggen som laddas upp med varje fil.
manual-changelog:
  filename: CHANGELOG.md
  markup-type: markdown

# Utvecklingsfiler som inte ska följa med till spelarna.
ignore:
  - AGENTS.md
  - CLAUDE.md
